[10/29 13:34:02     12s] 
[10/29 13:34:02     12s]     add_rings -nets {VDD VSS} -type core_rings -follow core \
[10/29 13:34:02     12s]         -layer {top Metal5 bottom Metal5 left Metal4 right Metal4} \
