[10/29 09:27:23     14s] @file 3: innovus_stage {
[10/29 09:27:23     14s]     # Post-route timing optimization:
[10/29 09:27:23     14s]     set report_dir [file join $report_root postroute]
[10/29 09:27:23     14s] 
[10/29 09:27:23     14s]     file mkdir $report_dir
[10/29 09:27:23     14s] 
[10/29 09:27:23     14s]     # Restore Routed Database:
[10/29 09:27:23     14s]     innovus_read_stage route
[10/29 09:27:23     14s] 
[10/29 09:27:23     14s]     # Disable Signal Integrity Analysis:
[10/29 09:27:23     14s]     set_db delaycal_enable_si false
[10/29 09:27:23     14s] 
[10/29 09:27:23     14s]     # Post-route Optimization:
[10/29 09:27:23     14s]     opt_design -post_route -setup
[10/29 09:27:23     14s]     opt_design -post_route -hold
[10/29 09:27:23     14s] 
[10/29 09:27:23     14s]     # Timing Reports:
[10/29 09:27:23     14s]     time_design -post_route -report_dir [file join $report_dir setup]
[10/29 09:27:23     14s]     time_design -post_route -hold -report_dir [file join $report_dir hold]
[10/29 09:27:23     14s] 
[10/29 09:27:23     14s]     # Save Post-route Database:
[10/29 09:27:23     14s]     write_db [file join $db_dir postroute_amba_3_apb_rsa_apb_top]
[10/29 09:27:23     14s] 
[10/29 09:27:23     14s]     exit
[10/29 09:27:23     14s] }
