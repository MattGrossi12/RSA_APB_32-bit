[10/28 17:28:05     11s]     time_design -post_route -hold -report_dir [file join $report_dir hold]
[10/28 17:28:05     11s] 
[10/28 17:28:05     11s]     # Save Post-route Database:
[10/28 17:28:05     11s]     write_db [file join $db_dir postroute_amba_3_apb_rsa_apb_top]
[10/28 17:28:05     11s] 
