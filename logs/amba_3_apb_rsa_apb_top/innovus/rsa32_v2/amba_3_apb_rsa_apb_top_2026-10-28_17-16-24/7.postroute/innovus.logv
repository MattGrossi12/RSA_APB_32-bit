[10/28 17:28:05     11s] 
[10/28 17:28:05     11s]     # Restore Routed Database:
[10/28 17:28:05     11s]     innovus_read_stage route
[10/28 17:28:05     11s] 
[10/28 17:28:05     11s]     # Disable Signal Integrity Analysis:
[10/28 17:28:05     11s]     set_db delaycal_enable_si false
[10/28 17:28:05     11s] 
[10/28 17:28:05     11s]     # Post-route Optimization:
[10/28 17:28:05     11s]     opt_design -post_route -setup
[10/28 17:28:05     11s]     opt_design -post_route -hold
[10/28 17:28:05     11s] 
[10/28 17:28:05     11s]     # Timing Reports:
