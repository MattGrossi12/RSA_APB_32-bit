[10/23 17:37:54     14s] @file 21:
[10/23 17:37:54     14s] @file 22: proc innovus_read_stage {stage} {
[10/23 17:37:54     14s]     global db_dir project_name
[10/23 17:37:54     14s]     set path [file join $db_dir ${stage}_${project_name}]
[10/23 17:37:54     14s]     if {![file exists $path]} {
