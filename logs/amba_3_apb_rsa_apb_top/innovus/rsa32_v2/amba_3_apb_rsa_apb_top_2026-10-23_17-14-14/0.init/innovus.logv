[10/23 17:15:53     12s] @file 21:
[10/23 17:15:53     12s] @file 22: proc innovus_read_stage {stage} {
[10/23 17:15:53     12s]     global db_dir project_name
[10/23 17:15:53     12s]     set path [file join $db_dir ${stage}_${project_name}]
[10/23 17:15:53     12s]     if {![file exists $path]} {
[10/23 17:15:53     12s]         error "Banco da etapa $stage ausente para esta sintese: $path. Execute a etapa anterior."
[10/23 17:15:53     12s]     }
[10/23 17:15:53     12s]     read_db $path
[10/23 17:15:53     12s] }
[10/23 17:15:53     12s] #@ End verbose source /home/aluno/Documents/RSA_APB_32-bit/scripts/amba_3_apb_rsa_apb_top/bash/../tcl/innovus_common.tcl
[10/23 17:15:53     12s] @file 2:
[10/23 17:15:53     12s] @file 3: innovus_stage {
[10/23 17:15:53     12s]     set lef_dir [file join $tech_dir LEF]
[10/23 17:15:53     12s]     set report_dir [file join $report_root init]
[10/23 17:15:53     12s]     file mkdir $db_dir $report_dir
[10/23 17:15:53     12s] 
[10/23 17:15:53     12s]     set_db design_process_node 45
[10/23 17:15:53     12s]     set_db add_route_vias_auto true
[10/23 17:15:53     12s]     set_db init_power_nets {VDD}
[10/23 17:15:53     12s]     set_db init_ground_nets {VSS}
[10/23 17:15:53     12s] 
[10/23 17:15:53     12s]     # Consume the mapped netlist and SDC from the same Genus execution.
[10/23 17:15:53     12s]     read_mmmc $::env(MMMC_FILE)
[10/23 17:15:53     12s]     read_physical -lef [list \
[10/23 17:15:53     12s]         [file join $lef_dir gsclib045_tech.lef] \
[10/23 17:15:53     12s]         [file join $lef_dir gsclib045_macro.lef]]
[10/23 17:15:53     12s]     read_netlist -top $project_name $::env(NETLIST_FILE)
[10/23 17:15:53     12s]     init_design
[10/23 17:15:53     12s] 
[10/23 17:15:53     12s]     check_timing -verbose > [file join $report_dir timing_constraints.rpt]
[10/23 17:15:53     12s]     write_db [file join $db_dir init_${project_name}]
[10/23 17:15:53     12s] 
[10/23 17:15:53     12s]     # Record provenance and select this run only after initialization succeeds.
[10/23 17:15:53     12s]     set provenance [open [file join $db_dir synthesis_inputs.txt] w]
[10/23 17:15:53     12s]     puts $provenance "RSA implementation: src/rsa32/v2"
[10/23 17:15:53     12s]     puts $provenance "Synthesis: $::env(SYNTH_RUN)"
[10/23 17:15:53     12s]     puts $provenance "Netlist: $::env(NETLIST_FILE)"
[10/23 17:15:53     12s]     puts $provenance "SDC: $::env(SDC_FILE)"
[10/23 17:15:53     12s]     close $provenance
[10/23 17:15:53     12s] 
[10/23 17:15:53     12s]     set marker [file join $::env(INNOVUS_BASE_DIR) active_run]
[10/23 17:15:53     12s]     set temporary "${marker}.[pid].tmp"
[10/23 17:15:53     12s]     set handle [open $temporary w]
[10/23 17:15:53     12s]     puts $handle $::env(SYNTH_RUN)
[10/23 17:15:53     12s]     close $handle
[10/23 17:15:53     12s]     file rename -force $temporary $marker
[10/23 17:15:53     12s]     exit
[10/23 17:15:53     12s] }
