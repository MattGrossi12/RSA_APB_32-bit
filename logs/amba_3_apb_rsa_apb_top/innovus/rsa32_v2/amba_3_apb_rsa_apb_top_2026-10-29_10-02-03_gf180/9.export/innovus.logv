[10/29 10:08:01     12s] @file 2:
[10/29 10:08:01     12s] @file 3: innovus_stage {
[10/29 10:08:01     12s]     # Experimental Export:
[10/29 10:08:01     12s]     set output_dir [file join $db_dir export]
[10/29 10:08:01     12s] 
[10/29 10:08:01     12s]     file mkdir $output_dir
[10/29 10:08:01     12s] 
[10/29 10:08:01     12s]     # Restore Post-route Database:
[10/29 10:08:01     12s]     innovus_read_stage postroute
[10/29 10:08:01     12s] 
[10/29 10:08:01     12s]     # DEF:
[10/29 10:08:01     12s]     write_def [file join $output_dir ${project_name}.def]
[10/29 10:08:01     12s] 
[10/29 10:08:01     12s]     # Verilog Netlist:
[10/29 10:08:01     12s]     write_netlist [file join $output_dir ${project_name}.v]
[10/29 10:08:01     12s] 
[10/29 10:08:01     12s]     # SDF:
[10/29 10:08:01     12s]     write_sdf [file join $output_dir ${project_name}.sdf]
[10/29 10:08:01     12s] 
[10/29 10:08:01     12s]     # Physical implementation constraints, including the synthesized clock budget.
[10/29 10:08:01     12s]     write_sdc [file join $output_dir ${project_name}.sdc]
[10/29 10:08:01     12s] 
[10/29 10:08:01     12s]     # Experimental GDSII:
[10/29 10:08:01     12s]     # Standard-cell layouts and validated GDS layer map are unavailable.
[10/29 10:08:01     12s]     write_stream [file join $output_dir ${project_name}_experimental.gds]
[10/29 10:08:01     12s] 
[10/29 10:08:01     12s]     exit
[10/29 10:08:01     12s] }
