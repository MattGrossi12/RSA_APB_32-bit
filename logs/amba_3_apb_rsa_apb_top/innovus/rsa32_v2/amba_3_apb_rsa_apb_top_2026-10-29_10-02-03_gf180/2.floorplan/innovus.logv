[10/29 10:03:57     12s] @file 2:
[10/29 10:03:57     12s] @file 3: innovus_stage {
[10/29 10:03:57     12s]     # Preliminary floorplan for GF180MCU; aspect=1, utilization=60%.
[10/29 10:03:57     12s]     innovus_read_stage init
[10/29 10:03:57     12s] 
[10/29 10:03:57     12s]     # Let Innovus use the default standard-cell site from the GF180 LEF.
[10/29 10:03:57     12s]     create_floorplan -core_density_size {1.0 0.60 10 10 10 10}
[10/29 10:03:57     12s] 
[10/29 10:03:57     12s]     # Block-level I/O pins on M3. Review their assignment in the GUI.
[10/29 10:03:57     12s]     edit_pin -side Left -layer M3 -spread_type center -spacing 0.6 \
[10/29 10:03:57     12s]         -pin [get_db [get_db ports -if {.direction == in}] .name]
[10/29 10:03:57     12s]     edit_pin -side Right -layer M3 -spread_type center -spacing 0.6 \
[10/29 10:03:57     12s]         -pin [get_db [get_db ports -if {.direction == out}] .name]
[10/29 10:03:57     12s] 
[10/29 10:03:57     12s]     write_db [file join $db_dir floorplan_amba_3_apb_rsa_apb_top]
[10/29 10:03:57     12s]     exit
[10/29 10:03:57     12s] }
