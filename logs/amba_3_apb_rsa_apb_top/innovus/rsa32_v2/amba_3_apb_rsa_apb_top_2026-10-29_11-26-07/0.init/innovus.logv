[10/29 11:27:17     14s] @file 2:
[10/29 11:27:17     14s] @file 3: innovus_stage {
[10/29 11:27:17     14s]     set report_dir [file join $report_root init]
[10/29 11:27:17     14s]     file mkdir $db_dir $report_dir
[10/29 11:27:17     14s] 
[10/29 11:27:17     14s]     # GPDK45/GSCLib045 (legacy):
[10/29 11:27:17     14s]     # set_db design_process_node 45
[10/29 11:27:17     14s]     # read_physical -lef [list \
[10/29 11:27:17     14s]     #     [file join $::env(INNOVUS_TECH_DIR) LEF gsclib045_tech.lef] \
[10/29 11:27:17     14s]     #     [file join $::env(INNOVUS_TECH_DIR) LEF gsclib045_macro.lef]]
[10/29 11:27:17     14s] 
[10/29 11:27:17     14s]     # FreePDK45 / Nangate Open Cell Library - 45 nm.
[10/29 11:27:17     14s]     set_db design_process_node 45
[10/29 11:27:17     14s] 
[10/29 11:27:17     14s]     # SKY130 - SkyWater 130 nm (legacy):
[10/29 11:27:17     14s]     # set_db design_process_node 130
[10/29 11:27:17     14s] 
[10/29 11:27:17     14s]     # GF180MCU - GlobalFoundries 180 nm / MCU7T5V0 (legacy):
[10/29 11:27:17     14s]     # set_db design_process_node 180
[10/29 11:27:17     14s]     set_db add_route_vias_auto true
[10/29 11:27:17     14s]     set_db init_power_nets {VDD}
[10/29 11:27:17     14s]     set_db init_ground_nets {VSS}
[10/29 11:27:17     14s] 
[10/29 11:27:17     14s]     # Consume the mapped netlist and SDC from the same Genus execution.
[10/29 11:27:17     14s]     read_mmmc $::env(MMMC_FILE)
[10/29 11:27:17     14s]     read_physical -lef [list $tech_lef $cell_lef]
[10/29 11:27:17     14s]     read_netlist -top $project_name $::env(NETLIST_FILE)
[10/29 11:27:17     14s]     init_design
[10/29 11:27:17     14s] 
[10/29 11:27:17     14s]     check_timing -verbose > [file join $report_dir timing_constraints.rpt]
[10/29 11:27:17     14s]     write_db [file join $db_dir init_${project_name}]
[10/29 11:27:17     14s] 
[10/29 11:27:17     14s]     # Record provenance and select this run only after initialization succeeds.
[10/29 11:27:17     14s]     set provenance [open [file join $db_dir synthesis_inputs.txt] w]
[10/29 11:27:17     14s]     puts $provenance "RSA implementation: src/rsa32/v2"
[10/29 11:27:17     14s]     puts $provenance "Synthesis: $::env(SYNTH_RUN)"
[10/29 11:27:17     14s]     puts $provenance "Netlist: $::env(NETLIST_FILE)"
[10/29 11:27:17     14s]     puts $provenance "SDC: $::env(SDC_FILE)"
[10/29 11:27:17     14s]     close $provenance
[10/29 11:27:17     14s] 
[10/29 11:27:17     14s]     set marker [file join $::env(INNOVUS_BASE_DIR) active_run]
[10/29 11:27:17     14s]     set temporary "${marker}.[pid].tmp"
[10/29 11:27:17     14s]     set handle [open $temporary w]
[10/29 11:27:17     14s]     puts $handle $::env(SYNTH_RUN)
[10/29 11:27:17     14s]     close $handle
[10/29 11:27:17     14s]     file rename -force $temporary $marker
[10/29 11:27:17     14s]     exit
[10/29 11:27:17     14s] }
