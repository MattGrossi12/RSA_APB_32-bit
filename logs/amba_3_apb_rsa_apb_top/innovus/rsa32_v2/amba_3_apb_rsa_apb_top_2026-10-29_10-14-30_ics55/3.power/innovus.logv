[10/29 10:17:34     11s] @file 2:
[10/29 10:17:34     11s] @file 3: innovus_stage {
[10/29 10:17:34     11s]     # Innovus 22.18 - RSA_APB power planning (ICsprout55 N551P6M).
[10/29 10:17:34     11s]     # Preliminary geometry; verify power connectivity and DRC before placement.
[10/29 10:17:34     11s] 
[10/29 10:17:34     11s]     set report_dir [file join $report_root power]
[10/29 10:17:34     11s]     file mkdir $report_dir
[10/29 10:17:34     11s] 
[10/29 10:17:34     11s]     innovus_read_stage floorplan
[10/29 10:17:34     11s] 
[10/29 10:17:34     11s]     connect_global_net VDD -type pg_pin -pin_base_name VDD -all
[10/29 10:17:34     11s]     connect_global_net VSS -type pg_pin -pin_base_name VSS -all
[10/29 10:17:34     11s] 
[10/29 10:17:34     11s]     add_rings -nets {VDD VSS} -type core_rings -follow core \
[10/29 10:17:34     11s]         -layer {top MET5 bottom MET5 left MET4 right MET4} \
[10/29 10:17:34     11s]         -width 1.0 -spacing 1.5 -offset 1.0
[10/29 10:17:34     11s] 
[10/29 10:17:34     11s]     add_stripes -nets {VDD VSS} -layer MET4 -direction vertical \
[10/29 10:17:34     11s]         -width 0.8 -spacing 1.5 -set_to_set_distance 25 \
[10/29 10:17:34     11s]         -start_from left -start_offset 15
[10/29 10:17:34     11s] 
[10/29 10:17:34     11s]     route_special -nets {VDD VSS} \
[10/29 10:17:34     11s]         -connect {core_pin floating_stripe} \
[10/29 10:17:34     11s]         -core_pin_target {ring stripe} \
[10/29 10:17:34     11s]         -floating_stripe_target {ring stripe followpin}
[10/29 10:17:34     11s] 
[10/29 10:17:34     11s]     check_connectivity -nets {VDD VSS} -type special \
[10/29 10:17:34     11s]         > [file join $report_dir power_connectivity.rpt]
[10/29 10:17:34     11s] 
[10/29 10:17:34     11s]     write_db [file join $db_dir power_amba_3_apb_rsa_apb_top]
[10/29 10:17:34     11s]     exit
[10/29 10:17:34     11s] }
