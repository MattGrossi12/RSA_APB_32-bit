@file 47: proc innovus_stage {body} {
    if {[catch {uplevel 1 $body} result]} {
        puts stderr "Erro no fluxo Innovus: $result"
        exit 1
    }
}
@file 53:
@file 54: proc innovus_read_stage {stage} {
    global db_dir project_name
    set path [file join $db_dir ${stage}_${project_name}]
    if {![file exists $path]} {
        error "Banco da etapa $stage ausente para esta sintese: $path. Execute a etapa anterior."
    }
    read_db $path
}
#@ End verbose source /home/aluno/Documents/RSA_APB_32-bit/scripts/amba_3_apb_rsa_apb_top/bash/../tcl/innovus_common.tcl
@file 2:
@file 3: innovus_stage {
    # Innovus 22.18 - RSA_APB power planning (ICsprout55 N551P6M).
    # Preliminary geometry; verify power connectivity and DRC before placement.

    set report_dir [file join $report_root power]
    file mkdir $report_dir

    innovus_read_stage floorplan

    connect_global_net VDD -type pg_pin -pin_base_name VDD -all
    connect_global_net VSS -type pg_pin -pin_base_name VSS -all

    add_rings -nets {VDD VSS} -type core_rings -follow core \
        -layer {top MET5 bottom MET5 left MET4 right MET4} \
        -width 1.0 -spacing 1.5 -offset 1.0

    add_stripes -nets {VDD VSS} -layer MET4 -direction vertical \
        -width 0.8 -spacing 1.5 -set_to_set_distance 25 \
        -start_from left -start_offset 15

    route_special -nets {VDD VSS} \
        -connect {core_pin floating_stripe} \
        -core_pin_target {ring stripe} \
        -floating_stripe_target {ring stripe followpin}

    check_connectivity -nets {VDD VSS} -type special \
        > [file join $report_dir power_connectivity.rpt]

    write_db [file join $db_dir power_amba_3_apb_rsa_apb_top]
    exit
}
