[10/29 10:49:37     12s] @file 3: innovus_stage {
[10/29 10:49:37     12s]     # Post-route timing optimization:
[10/29 10:49:37     12s]     set report_dir [file join $report_root postroute]
[10/29 10:49:37     12s] 
[10/29 10:49:37     12s]     file mkdir $report_dir
[10/29 10:49:37     12s] 
[10/29 10:49:37     12s]     # Restore Routed Database:
[10/29 10:49:37     12s]     innovus_read_stage route
[10/29 10:49:37     12s] 
[10/29 10:49:37     12s]     # Disable Signal Integrity Analysis:
[10/29 10:49:37     12s]     set_db delaycal_enable_si false
[10/29 10:49:37     12s] 
[10/29 10:49:37     12s]     # Post-route Optimization:
[10/29 10:49:37     12s]     opt_design -post_route -setup
[10/29 10:49:37     12s]     opt_design -post_route -hold
[10/29 10:49:37     12s] 
[10/29 10:49:37     12s]     # Timing Reports:
[10/29 10:49:37     12s]     time_design -post_route -report_dir [file join $report_dir setup]
[10/29 10:49:37     12s]     time_design -post_route -hold -report_dir [file join $report_dir hold]
[10/29 10:49:37     12s] 
[10/29 10:49:37     12s]     # Save Post-route Database:
[10/29 10:49:37     12s]     write_db [file join $db_dir postroute_amba_3_apb_rsa_apb_top]
[10/29 10:49:37     12s] 
[10/29 10:49:37     12s]     exit
[10/29 10:49:37     12s] }
