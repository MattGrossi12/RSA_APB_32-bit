[10/29 10:47:32     14s] @file 2:
[10/29 10:47:32     14s] @file 3: innovus_stage {
[10/29 10:47:32     14s]     # Clock tree synthesis and post-CTS optimization.
[10/29 10:47:32     14s]     set report_dir [file join $report_root cts]
[10/29 10:47:32     14s]     file mkdir $report_dir
[10/29 10:47:32     14s]     innovus_read_stage place
[10/29 10:47:32     14s] 
[10/29 10:47:32     14s]     # Explicit CTS cells for the ICsprout55 H7CR library.
[10/29 10:47:32     14s]     # These cells were reported as usable by Innovus, but CCOpt did not
[10/29 10:47:32     14s]     # automatically include them in the balanced-cell candidate table.
[10/29 10:47:32     14s]     set_db / .cts_buffer_cells {
[10/29 10:47:32     14s]         BUFX4H7R BUFX8H7R BUFX12H7R BUFX16H7R
[10/29 10:47:32     14s]     }
[10/29 10:47:32     14s]     set_db / .cts_inverter_cells {
[10/29 10:47:32     14s]         INVX4H7R INVX8H7R INVX12H7R INVX16H7R
[10/29 10:47:32     14s]     }
[10/29 10:47:32     14s] 
[10/29 10:47:32     14s]     ccopt_design
[10/29 10:47:32     14s]     time_design -post_cts -report_dir [file join $report_dir post_cts]
[10/29 10:47:32     14s] 
[10/29 10:47:32     14s]     write_db [file join $db_dir cts_amba_3_apb_rsa_apb_top]
[10/29 10:47:32     14s]     exit
[10/29 10:47:32     14s] }
