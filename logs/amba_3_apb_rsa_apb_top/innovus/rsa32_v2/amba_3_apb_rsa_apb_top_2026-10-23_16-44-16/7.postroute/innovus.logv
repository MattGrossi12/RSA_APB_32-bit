[10/23 17:06:25     12s] }
[10/23 17:06:25     12s] @file 21:
[10/23 17:06:25     12s] @file 22: proc innovus_read_stage {stage} {
[10/23 17:06:25     12s]     global db_dir project_name
[10/23 17:06:25     12s]     set path [file join $db_dir ${stage}_${project_name}]
[10/23 17:06:25     12s]     if {![file exists $path]} {
[10/23 17:06:25     12s]         error "Banco da etapa $stage ausente para esta sintese: $path. Execute a etapa anterior."
[10/23 17:06:25     12s]     }
[10/23 17:06:25     12s]     read_db $path
[10/23 17:06:25     12s] }
[10/23 17:06:25     12s] #@ End verbose source /home/aluno/Documents/RSA_APB_32-bit/scripts/amba_3_apb_rsa_apb_top/bash/../tcl/innovus_common.tcl
[10/23 17:06:25     12s] @file 2:
[10/23 17:06:25     12s] @file 3: innovus_stage {
[10/23 17:06:25     12s]     # Post-route timing optimization:
[10/23 17:06:25     12s]     set report_dir [file join $report_root postroute]
[10/23 17:06:25     12s] 
[10/23 17:06:25     12s]     file mkdir $report_dir
[10/23 17:06:25     12s] 
[10/23 17:06:25     12s]     # Restore Routed Database:
[10/23 17:06:25     12s]     innovus_read_stage route
[10/23 17:06:25     12s] 
[10/23 17:06:25     12s]     # Disable Signal Integrity Analysis:
[10/23 17:06:25     12s]     set_db delaycal_enable_si false
[10/23 17:06:25     12s] 
[10/23 17:06:25     12s]     # Post-route Optimization:
[10/23 17:06:25     12s]     opt_design -post_route -setup
[10/23 17:06:25     12s]     opt_design -post_route -hold
[10/23 17:06:25     12s] 
[10/23 17:06:25     12s]     # Timing Reports:
[10/23 17:06:25     12s]     time_design -post_route -report_dir [file join $report_dir setup]
[10/23 17:06:25     12s]     time_design -post_route -hold -report_dir [file join $report_dir hold]
[10/23 17:06:25     12s] 
[10/23 17:06:25     12s]     # Save Post-route Database:
[10/23 17:06:25     12s]     write_db [file join $db_dir postroute_amba_3_apb_rsa_apb_top]
[10/23 17:06:25     12s] 
[10/23 17:06:25     12s]     exit
[10/23 17:06:25     12s] }
