[10/23 17:06:25     12s] @file 8:
[10/23 17:06:25     12s] @file 9: set project_name "amba_3_apb_rsa_apb_top"
[10/23 17:06:25     12s] @file 10: set project_root $::env(PROJECT_ROOT)
[10/23 17:06:25     12s] @file 11: set db_dir $::env(INNOVUS_DB_DIR)
[10/23 17:06:25     12s] @file 12: set report_root $::env(INNOVUS_REPORT_DIR)
[10/23 17:06:25     12s] @file 13: set tech_dir $::env(INNOVUS_TECH_DIR)
[10/23 17:06:25     12s] @file 14:
[10/23 17:06:25     12s] @file 15: proc innovus_stage {body} {
[10/23 17:06:25     12s]     if {[catch {uplevel 1 $body} result]} {
