[10/23 17:08:26     12s] 
[10/23 17:08:26     12s]     # Restore Post-route Database:
[10/23 17:08:26     12s]     innovus_read_stage postroute
[10/23 17:08:26     12s] 
[10/23 17:08:26     12s]     # DEF:
[10/23 17:08:26     12s]     write_def [file join $output_dir ${project_name}.def]
[10/23 17:08:26     12s] 
[10/23 17:08:26     12s]     # Verilog Netlist:
[10/23 17:08:26     12s]     write_netlist [file join $output_dir ${project_name}.v]
[10/23 17:08:26     12s] 
[10/23 17:08:26     12s]     # SDF:
