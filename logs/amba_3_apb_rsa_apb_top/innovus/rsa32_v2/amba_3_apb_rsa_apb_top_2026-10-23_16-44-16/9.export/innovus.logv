[10/23 17:08:26     12s] 
[10/23 17:08:26     12s]     # Physical implementation constraints, including the synthesized clock budget.
[10/23 17:08:26     12s]     write_sdc [file join $output_dir ${project_name}.sdc]
[10/23 17:08:26     12s] 
