[10/23 17:08:26     12s] @file 21:
[10/23 17:08:26     12s] @file 22: proc innovus_read_stage {stage} {
[10/23 17:08:26     12s]     global db_dir project_name
[10/23 17:08:26     12s]     set path [file join $db_dir ${stage}_${project_name}]
[10/23 17:08:26     12s]     if {![file exists $path]} {
