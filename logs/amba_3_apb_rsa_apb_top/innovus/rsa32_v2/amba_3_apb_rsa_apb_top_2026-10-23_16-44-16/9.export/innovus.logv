[10/23 17:08:26     12s] @file 2:
[10/23 17:08:26     12s] @file 3: innovus_stage {
[10/23 17:08:26     12s]     # Experimental Export:
[10/23 17:08:26     12s]     set output_dir [file join $db_dir export]
[10/23 17:08:26     12s] 
