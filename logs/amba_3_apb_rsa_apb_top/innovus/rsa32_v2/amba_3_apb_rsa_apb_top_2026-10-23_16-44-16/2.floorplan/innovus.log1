#@ Begin verbose source /home/aluno/Documents/RSA_APB_32-bit/scripts/amba_3_apb_rsa_apb_top/bash/../tcl/innovus_common.tcl (pre)
@file 1: # Context shared by every stage of the RSA32 v2 flow.
@file 2: foreach required {PROJECT_ROOT SYNTH_RUN NETLIST_FILE SDC_FILE INNOVUS_BASE_DIR INNOVUS_DB_DIR INNOVUS_REPORT_DIR INNOVUS_TECH_DIR} {
    if {![info exists ::env($required)] || $::env($required) eq ""} {
        puts stderr "Erro: variavel $required ausente. Execute o script Bash da etapa."
        exit 1
    }
}
@file 8:
@file 9: set project_name "amba_3_apb_rsa_apb_top"
@file 10: set project_root $::env(PROJECT_ROOT)
@file 11: set db_dir $::env(INNOVUS_DB_DIR)
@file 12: set report_root $::env(INNOVUS_REPORT_DIR)
@file 13: set tech_dir $::env(INNOVUS_TECH_DIR)
@file 14:
@file 15: proc innovus_stage {body} {
    if {[catch {uplevel 1 $body} result]} {
        puts stderr "Erro no fluxo Innovus: $result"
        exit 1
    }
}
@file 21:
@file 22: proc innovus_read_stage {stage} {
    global db_dir project_name
    set path [file join $db_dir ${stage}_${project_name}]
    if {![file exists $path]} {
        error "Banco da etapa $stage ausente para esta sintese: $path. Execute a etapa anterior."
    }
    read_db $path
}
#@ End verbose source /home/aluno/Documents/RSA_APB_32-bit/scripts/amba_3_apb_rsa_apb_top/bash/../tcl/innovus_common.tcl
@file 2:
@file 3: innovus_stage {
    # Preliminary floorplan for GSCLib045; aspect=1, utilization=60%.
    innovus_read_stage init

    create_floorplan -site CoreSite -core_density_size {1.0 0.60 10 10 10 10}

    # Block-level I/O pins on M3. Review their assignment in the GUI.
    edit_pin -side Left -layer M3 -spread_type center -spacing 0.6 \
        -pin [get_db [get_db ports -if {.direction == in}] .name]
    edit_pin -side Right -layer M3 -spread_type center -spacing 0.6 \
        -pin [get_db [get_db ports -if {.direction == out}] .name]

    write_db [file join $db_dir floorplan_amba_3_apb_rsa_apb_top]
    exit
}
