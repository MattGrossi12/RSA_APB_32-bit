[10/29 14:06:55     14s] @file 2:
[10/29 14:06:55     14s] @file 3: innovus_stage {
[10/29 14:06:55     14s]     # Preliminary floorplan for IHP SG13G2; aspect=1, utilization=60%.
[10/29 14:06:55     14s]     innovus_read_stage init
[10/29 14:06:55     14s] 
[10/29 14:06:55     14s]     # Let Innovus select the site declared by the IHP standard-cell LEF.
[10/29 14:06:55     14s]     create_floorplan -core_density_size {1.0 0.60 10 10 10 10}
[10/29 14:06:55     14s] 
[10/29 14:06:55     14s]     # Block-level I/O pins on M3. Review their assignment in the GUI.
[10/29 14:06:55     14s]     edit_pin -side Left -layer M3 -spread_type center -spacing 0.6 \
[10/29 14:06:55     14s]         -pin [get_db [get_db ports -if {.direction == in}] .name]
[10/29 14:06:55     14s]     edit_pin -side Right -layer M3 -spread_type center -spacing 0.6 \
[10/29 14:06:55     14s]         -pin [get_db [get_db ports -if {.direction == out}] .name]
[10/29 14:06:55     14s] 
[10/29 14:06:55     14s]     write_db [file join $db_dir floorplan_amba_3_apb_rsa_apb_top]
[10/29 14:06:55     14s]     exit
[10/29 14:06:55     14s] }
