[10/29 14:14:33     15s] @file 2:
[10/29 14:14:33     15s] @file 3: innovus_stage {
[10/29 14:14:33     15s]     # The final database is the default; fallback requires explicit auto mode.
[10/29 14:14:33     15s]     set selected_stage postroute
[10/29 14:14:33     15s]     if {[info exists ::env(INNOVUS_DB_STAGE)] && $::env(INNOVUS_DB_STAGE) ne ""} {
[10/29 14:14:33     15s]         set selected_stage $::env(INNOVUS_DB_STAGE)
[10/29 14:14:33     15s]     }
[10/29 14:14:33     15s]     if {$selected_stage eq "auto"} {
[10/29 14:14:33     15s]         set stages {postroute route cts place power floorplan init}
[10/29 14:14:33     15s]     } else {
[10/29 14:14:33     15s]         set stages [list $selected_stage]
[10/29 14:14:33     15s]     }
[10/29 14:14:33     15s]     set restored false
[10/29 14:14:33     15s]     foreach stage $stages {
[10/29 14:14:33     15s]         if {$stage ni {postroute route cts place power floorplan init}} {
[10/29 14:14:33     15s]             error "Etapa de banco invalida: $stage"
[10/29 14:14:33     15s]         }
[10/29 14:14:33     15s]         set db_path [file join $db_dir ${stage}_${project_name}]
[10/29 14:14:33     15s]         if {[file exists $db_path]} {
[10/29 14:14:33     15s]             puts "Abrindo banco GUI: $db_path"
[10/29 14:14:33     15s]             innovus_read_stage $stage
[10/29 14:14:33     15s]             set restored true
[10/29 14:14:33     15s]             break
[10/29 14:14:33     15s]         }
[10/29 14:14:33     15s]     }
[10/29 14:14:33     15s]     if {!$restored} {
[10/29 14:14:33     15s]         error "Banco $selected_stage ausente para $::env(SYNTH_RUN). Execute a etapa correspondente ou selecione uma etapa existente com INNOVUS_DB_STAGE."
[10/29 14:14:33     15s]     }
[10/29 14:14:33     15s]     gui_show
[10/29 14:14:33     15s]     gui_fit
[10/29 14:14:33     15s] }
