@file 58:
@file 59: proc innovus_stage {body} {
    if {[catch {uplevel 1 $body} result]} {
        puts stderr "Erro no fluxo Innovus: $result"
        exit 1
    }
}
@file 65:
@file 66: proc innovus_read_stage {stage} {
    global db_dir project_name
    set path [file join $db_dir ${stage}_${project_name}]
    if {![file exists $path]} {
        error "Banco da etapa $stage ausente para esta sintese: $path. Execute a etapa anterior."
    }
    read_db $path
}
#@ End verbose source /home/aluno/Documents/RSA_APB_32-bit/scripts/amba_3_apb_rsa_apb_top/bash/../tcl/innovus_common.tcl
@file 2:
@file 3: innovus_stage {
    set report_dir [file join $report_root init]
    file mkdir $db_dir $report_dir

    # GPDK45/GSCLib045 (legacy):
    # set_db design_process_node 45
    # read_physical -lef [list \
    #     [file join $::env(INNOVUS_TECH_DIR) LEF gsclib045_tech.lef] \
    #     [file join $::env(INNOVUS_TECH_DIR) LEF gsclib045_macro.lef]]

    # ASAP7 / ASAP7SC7P5T_RVT - 7 nm FinFET.
    set_db design_process_node 7

    # SKY130 - SkyWater 130 nm (legacy):
    # set_db design_process_node 130

    # GF180MCU - GlobalFoundries 180 nm / MCU7T5V0 (legacy):
    # set_db design_process_node 180
    set_db add_route_vias_auto true
    set_db init_power_nets {VDD}
    set_db init_ground_nets {VSS}

    # Consume the mapped netlist and SDC from the same Genus execution.
    read_mmmc $::env(MMMC_FILE)
    read_physical -lef [list $tech_lef $cell_lef]
    read_netlist -top $project_name $::env(NETLIST_FILE)
    init_design

    check_timing -verbose > [file join $report_dir timing_constraints.rpt]
    write_db [file join $db_dir init_${project_name}]

    # Record provenance and select this run only after initialization succeeds.
    set provenance [open [file join $db_dir synthesis_inputs.txt] w]
    puts $provenance "RSA implementation: src/rsa32/v2"
    puts $provenance "Synthesis: $::env(SYNTH_RUN)"
    puts $provenance "Netlist: $::env(NETLIST_FILE)"
    puts $provenance "SDC: $::env(SDC_FILE)"
    close $provenance

    set marker [file join $::env(INNOVUS_BASE_DIR) active_run]
    set temporary "${marker}.[pid].tmp"
    set handle [open $temporary w]
    puts $handle $::env(SYNTH_RUN)
    close $handle
    file rename -force $temporary $marker
    exit
}
