[10/29 09:37:08     11s] @file 44:
[10/29 09:37:08     11s] @file 45: proc innovus_read_stage {stage} {
[10/29 09:37:08     11s]     global db_dir project_name
[10/29 09:37:08     11s]     set path [file join $db_dir ${stage}_${project_name}]
[10/29 09:37:08     11s]     if {![file exists $path]} {
[10/29 09:37:08     11s]         error "Banco da etapa $stage ausente para esta sintese: $path. Execute a etapa anterior."
[10/29 09:37:08     11s]     }
[10/29 09:37:08     11s]     read_db $path
[10/29 09:37:08     11s] }
