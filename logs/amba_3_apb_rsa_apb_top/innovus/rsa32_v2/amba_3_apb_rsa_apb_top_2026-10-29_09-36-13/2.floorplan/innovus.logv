[10/29 09:37:39     11s] @file 3: innovus_stage {
[10/29 09:37:39     11s]     # Preliminary floorplan for SKY130; aspect=1, utilization=60%.
[10/29 09:37:39     11s]     innovus_read_stage init
[10/29 09:37:39     11s] 
[10/29 09:37:39     11s]     create_floorplan -site unithd -core_density_size {1.0 0.60 10 10 10 10}
[10/29 09:37:39     11s] 
[10/29 09:37:39     11s]     # Block-level I/O pins on M3. Review their assignment in the GUI.
[10/29 09:37:39     11s]     edit_pin -side Left -layer M3 -spread_type center -spacing 0.6 \
[10/29 09:37:39     11s]         -pin [get_db [get_db ports -if {.direction == in}] .name]
[10/29 09:37:39     11s]     edit_pin -side Right -layer M3 -spread_type center -spacing 0.6 \
[10/29 09:37:39     11s]         -pin [get_db [get_db ports -if {.direction == out}] .name]
[10/29 09:37:39     11s] 
[10/29 09:37:39     11s]     write_db [file join $db_dir floorplan_amba_3_apb_rsa_apb_top]
[10/29 09:37:39     11s]     exit
[10/29 09:37:39     11s] }
