[10/29 11:35:14     12s] @file 2:
[10/29 11:35:14     12s] @file 3: innovus_stage {
[10/29 11:35:14     12s]     # Clock tree synthesis and post-CTS optimization.
[10/29 11:35:14     12s]     set report_dir [file join $report_root cts]
[10/29 11:35:14     12s]     file mkdir $report_dir
[10/29 11:35:14     12s]     innovus_read_stage place
[10/29 11:35:14     12s] 
[10/29 11:35:14     12s]     # IHP SG13G2 CTS cells are intentionally left to the library/CCOpt
[10/29 11:35:14     12s]     # classification. The previous H7CR-specific cell list was archived
[10/29 11:35:14     12s]     # with the ICS55 run and must not be reused for IHP.
[10/29 11:35:14     12s] 
[10/29 11:35:14     12s]     ccopt_design
[10/29 11:35:14     12s]     time_design -post_cts -report_dir [file join $report_dir post_cts]
[10/29 11:35:14     12s] 
[10/29 11:35:14     12s]     write_db [file join $db_dir cts_amba_3_apb_rsa_apb_top]
[10/29 11:35:14     12s]     exit
[10/29 11:35:14     12s] }
