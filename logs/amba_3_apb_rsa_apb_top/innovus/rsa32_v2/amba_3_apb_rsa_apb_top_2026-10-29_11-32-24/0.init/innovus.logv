[10/29 11:33:36     13s] 
[10/29 11:33:36     13s]     # GPDK45/GSCLib045 (legacy):
[10/29 11:33:36     13s]     # set_db design_process_node 45
[10/29 11:33:36     13s]     # read_physical -lef [list \
[10/29 11:33:36     13s]     #     [file join $::env(INNOVUS_TECH_DIR) LEF gsclib045_tech.lef] \
[10/29 11:33:36     13s]     #     [file join $::env(INNOVUS_TECH_DIR) LEF gsclib045_macro.lef]]
[10/29 11:33:36     13s] 
[10/29 11:33:36     13s]     # FreePDK45 / Nangate Open Cell Library - 45 nm.
[10/29 11:33:36     13s]     set_db design_process_node 45
[10/29 11:33:36     13s] 
[10/29 11:33:36     13s]     # SKY130 - SkyWater 130 nm (legacy):
[10/29 11:33:36     13s]     # set_db design_process_node 130
[10/29 11:33:36     13s] 
[10/29 11:33:36     13s]     # GF180MCU - GlobalFoundries 180 nm / MCU7T5V0 (legacy):
[10/29 11:33:36     13s]     # set_db design_process_node 180
[10/29 11:33:36     13s]     set_db add_route_vias_auto true
[10/29 11:33:36     13s]     set_db init_power_nets {VDD}
[10/29 11:33:36     13s]     set_db init_ground_nets {VSS}
[10/29 11:33:36     13s] 
[10/29 11:33:36     13s]     # Consume the mapped netlist and SDC from the same Genus execution.
[10/29 11:33:36     13s]     read_mmmc $::env(MMMC_FILE)
[10/29 11:33:36     13s]     read_physical -lef [list $tech_lef $cell_lef]
[10/29 11:33:36     13s]     read_netlist -top $project_name $::env(NETLIST_FILE)
[10/29 11:33:36     13s]     init_design
[10/29 11:33:36     13s] 
[10/29 11:33:36     13s]     check_timing -verbose > [file join $report_dir timing_constraints.rpt]
[10/29 11:33:36     13s]     write_db [file join $db_dir init_${project_name}]
[10/29 11:33:36     13s] 
[10/29 11:33:36     13s]     # Record provenance and select this run only after initialization succeeds.
[10/29 11:33:36     13s]     set provenance [open [file join $db_dir synthesis_inputs.txt] w]
[10/29 11:33:36     13s]     puts $provenance "RSA implementation: src/rsa32/v2"
[10/29 11:33:36     13s]     puts $provenance "Synthesis: $::env(SYNTH_RUN)"
[10/29 11:33:36     13s]     puts $provenance "Netlist: $::env(NETLIST_FILE)"
[10/29 11:33:36     13s]     puts $provenance "SDC: $::env(SDC_FILE)"
[10/29 11:33:36     13s]     close $provenance
[10/29 11:33:36     13s] 
[10/29 11:33:36     13s]     set marker [file join $::env(INNOVUS_BASE_DIR) active_run]
[10/29 11:33:36     13s]     set temporary "${marker}.[pid].tmp"
[10/29 11:33:36     13s]     set handle [open $temporary w]
[10/29 11:33:36     13s]     puts $handle $::env(SYNTH_RUN)
[10/29 11:33:36     13s]     close $handle
[10/29 11:33:36     13s]     file rename -force $temporary $marker
[10/29 11:33:36     13s]     exit
[10/29 11:33:36     13s] }
