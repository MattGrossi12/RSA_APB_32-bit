[10/29 11:34:21     12s] 
[10/29 11:34:21     12s]     connect_global_net VDD -type pg_pin -pin_base_name VDD -all
[10/29 11:34:21     12s]     connect_global_net VSS -type pg_pin -pin_base_name VSS -all
[10/29 11:34:21     12s] 
[10/29 11:34:21     12s]     add_rings -nets {VDD VSS} -type core_rings -follow core \
[10/29 11:34:21     12s]         -layer {top Metal5 bottom Metal5 left Metal4 right Metal4} \
[10/29 11:34:21     12s]         -width 1.0 -spacing 1.5 -offset 1.0
[10/29 11:34:21     12s] 
[10/29 11:34:21     12s]     add_stripes -nets {VDD VSS} -layer Metal4 -direction vertical \
[10/29 11:34:21     12s]         -width 0.8 -spacing 1.5 -set_to_set_distance 25 \
[10/29 11:34:21     12s]         -start_from left -start_offset 15
[10/29 11:34:21     12s] 
[10/29 11:34:21     12s]     route_special -nets {VDD VSS} \
[10/29 11:34:21     12s]         -connect {core_pin floating_stripe} \
[10/29 11:34:21     12s]         -core_pin_target {ring stripe} \
[10/29 11:34:21     12s]         -floating_stripe_target {ring stripe followpin}
[10/29 11:34:21     12s] 
[10/29 11:34:21     12s]     check_connectivity -nets {VDD VSS} -type special \
[10/29 11:34:21     12s]         > [file join $report_dir power_connectivity.rpt]
[10/29 11:34:21     12s] 
[10/29 11:34:21     12s]     write_db [file join $db_dir power_amba_3_apb_rsa_apb_top]
[10/29 11:34:21     12s]     exit
[10/29 11:34:21     12s] }
