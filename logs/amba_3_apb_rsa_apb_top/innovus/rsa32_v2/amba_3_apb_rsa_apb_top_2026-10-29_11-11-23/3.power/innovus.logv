[10/29 11:13:22     12s] @file 3: innovus_stage {
[10/29 11:13:22     12s]     # Innovus 22.18 - RSA_APB power planning (IHP SG13G2 5M2TL).
[10/29 11:13:22     12s]     # Preliminary geometry; verify power connectivity and DRC before placement.
[10/29 11:13:22     12s] 
[10/29 11:13:22     12s]     set report_dir [file join $report_root power]
[10/29 11:13:22     12s]     file mkdir $report_dir
[10/29 11:13:22     12s] 
[10/29 11:13:22     12s]     innovus_read_stage floorplan
[10/29 11:13:22     12s] 
[10/29 11:13:22     12s]     connect_global_net VDD -type pg_pin -pin_base_name VDD -all
[10/29 11:13:22     12s]     connect_global_net VSS -type pg_pin -pin_base_name VSS -all
[10/29 11:13:22     12s] 
[10/29 11:13:22     12s]     add_rings -nets {VDD VSS} -type core_rings -follow core \
[10/29 11:13:22     12s]         -layer {top Metal5 bottom Metal5 left Metal4 right Metal4} \
[10/29 11:13:22     12s]         -width 1.0 -spacing 1.5 -offset 1.0
[10/29 11:13:22     12s] 
[10/29 11:13:22     12s]     add_stripes -nets {VDD VSS} -layer Metal4 -direction vertical \
[10/29 11:13:22     12s]         -width 0.8 -spacing 1.5 -set_to_set_distance 25 \
[10/29 11:13:22     12s]         -start_from left -start_offset 15
[10/29 11:13:22     12s] 
[10/29 11:13:22     12s]     route_special -nets {VDD VSS} \
[10/29 11:13:22     12s]         -connect {core_pin floating_stripe} \
[10/29 11:13:22     12s]         -core_pin_target {ring stripe} \
[10/29 11:13:22     12s]         -floating_stripe_target {ring stripe followpin}
[10/29 11:13:22     12s] 
[10/29 11:13:22     12s]     check_connectivity -nets {VDD VSS} -type special \
[10/29 11:13:22     12s]         > [file join $report_dir power_connectivity.rpt]
[10/29 11:13:22     12s] 
[10/29 11:13:22     12s]     write_db [file join $db_dir power_amba_3_apb_rsa_apb_top]
[10/29 11:13:22     12s]     exit
[10/29 11:13:22     12s] }
