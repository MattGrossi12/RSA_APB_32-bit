[10/29 11:18:18     14s] @file 2:
[10/29 11:18:18     14s] @file 3: innovus_stage {
[10/29 11:18:18     14s]     # The final database is the default; fallback requires explicit auto mode.
[10/29 11:18:18     14s]     set selected_stage postroute
[10/29 11:18:18     14s]     if {[info exists ::env(INNOVUS_DB_STAGE)] && $::env(INNOVUS_DB_STAGE) ne ""} {
[10/29 11:18:18     14s]         set selected_stage $::env(INNOVUS_DB_STAGE)
[10/29 11:18:18     14s]     }
[10/29 11:18:18     14s]     if {$selected_stage eq "auto"} {
[10/29 11:18:18     14s]         set stages {postroute route cts place power floorplan init}
[10/29 11:18:18     14s]     } else {
[10/29 11:18:18     14s]         set stages [list $selected_stage]
[10/29 11:18:18     14s]     }
[10/29 11:18:18     14s]     set restored false
[10/29 11:18:18     14s]     foreach stage $stages {
[10/29 11:18:18     14s]         if {$stage ni {postroute route cts place power floorplan init}} {
[10/29 11:18:18     14s]             error "Etapa de banco invalida: $stage"
[10/29 11:18:18     14s]         }
[10/29 11:18:18     14s]         set db_path [file join $db_dir ${stage}_${project_name}]
[10/29 11:18:18     14s]         if {[file exists $db_path]} {
[10/29 11:18:18     14s]             puts "Abrindo banco GUI: $db_path"
[10/29 11:18:18     14s]             innovus_read_stage $stage
[10/29 11:18:18     14s]             set restored true
[10/29 11:18:18     14s]             break
[10/29 11:18:18     14s]         }
[10/29 11:18:18     14s]     }
[10/29 11:18:18     14s]     if {!$restored} {
[10/29 11:18:18     14s]         error "Banco $selected_stage ausente para $::env(SYNTH_RUN). Execute a etapa correspondente ou selecione uma etapa existente com INNOVUS_DB_STAGE."
[10/29 11:18:18     14s]     }
[10/29 11:18:18     14s]     gui_show
[10/29 11:18:18     14s]     gui_fit
[10/29 11:18:18     14s] }
