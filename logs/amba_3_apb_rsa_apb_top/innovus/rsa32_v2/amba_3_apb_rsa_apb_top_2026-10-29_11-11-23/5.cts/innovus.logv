[10/29 11:14:28     14s] @file 2:
[10/29 11:14:28     14s] @file 3: innovus_stage {
[10/29 11:14:28     14s]     # Clock tree synthesis and post-CTS optimization.
[10/29 11:14:28     14s]     set report_dir [file join $report_root cts]
[10/29 11:14:28     14s]     file mkdir $report_dir
[10/29 11:14:28     14s]     innovus_read_stage place
[10/29 11:14:28     14s] 
[10/29 11:14:28     14s]     # IHP SG13G2 CTS cells are intentionally left to the library/CCOpt
[10/29 11:14:28     14s]     # classification. The previous H7CR-specific cell list was archived
[10/29 11:14:28     14s]     # with the ICS55 run and must not be reused for IHP.
[10/29 11:14:28     14s] 
[10/29 11:14:28     14s]     ccopt_design
[10/29 11:14:28     14s]     time_design -post_cts -report_dir [file join $report_dir post_cts]
[10/29 11:14:28     14s] 
[10/29 11:14:28     14s]     write_db [file join $db_dir cts_amba_3_apb_rsa_apb_top]
[10/29 11:14:28     14s]     exit
[10/29 11:14:28     14s] }
