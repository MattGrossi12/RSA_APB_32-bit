          (IOPATH CI S (::208) (::197))
          (COND (A&B) (IOPATH CI S (::113) (::126)))
          (COND (B&CI) (IOPATH A S (::116) (::122)))
          (IOPATH A S (::219) (::208))
          (COND (~A&~B) (IOPATH CI S (::105) (::141)))
          (COND (A&~B) (IOPATH CI S (::204) (::197)))
          (COND (B&~CI) (IOPATH A S (::216) (::202)))
          (COND (~B&CI) (IOPATH A S (::212) (::208)))
          (COND (~A&CI) (IOPATH B S (::214) (::212)))
          (COND (A&CI) (IOPATH B S (::122) (::139)))
        )
     )
  )
)
